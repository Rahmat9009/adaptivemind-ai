AI_API_KEY=
AI_BASE_URL=
AI_MODEL=gemini-flash-latest

# Optional. Ada uses this provider only when the primary provider is unavailable.
AI_FALLBACK_API_KEY=
AI_FALLBACK_BASE_URL=
AI_FALLBACK_MODEL=

# Optional emergency text fallback. Used only when the providers above fail
# with a transient/provider/quota error. Leave blank to disable Groq entirely;
# Gemini continues to work unchanged without it.
# Endpoint https://api.groq.com/openai/v1 and model openai/gpt-oss-120b
# are set in code and need no environment entries.
GROQ_API_KEY=
